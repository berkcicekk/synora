# Synora üretim ayarları. /etc/synora/synora.env olarak kopyalayın; izin 600, sahibi root.
# Boş bırakılan değerler için kod içindeki öntanımlı kullanılır (src/synora/web/settings.py).

# Öğrencilerin tarayıcıda açtığı adres; giriş bağlantıları bununla kurulur. https olmalı.
SYNORA_BASE_URL=https://synora.example.edu.tr

# Giriş yapabilecek e-posta alan adları (virgülle).
SYNORA_ALLOWED_DOMAINS=beun.edu.tr,ogrenci.beun.edu.tr

# Veritabanı: yalnızca e-posta, oturum, rapor (tez metni yok). Dizin servis kullanıcısına yazılabilir olmalı.
# Docker ile kurulumda bu iki yolu compose.yaml kapsayıcı içindekilerle değiştirir.
SYNORA_DB_PATH=/var/lib/synora/synora.db
SYNORA_RULESETS_DIR=/opt/synora/rulesets
SYNORA_DEFAULT_RULESET=zbeu-tip

# Saklama ve kapasite
SYNORA_RETENTION_HOURS=24
SYNORA_WORKERS=2

# Giriş bağlantısı e-postası (SMTP, STARTTLS). Sağlayıcı kararı bekleniyor.
SYNORA_SMTP_HOST=smtp.example.edu.tr
SYNORA_SMTP_PORT=587
SYNORA_SMTP_USER=synora
SYNORA_SMTP_PASSWORD=
SYNORA_SMTP_FROM=Synora <synora@example.edu.tr>

# Üretimde HER ZAMAN 0 (1 = bağlantılar konsola yazılır, çerezler Secure olmaz).
SYNORA_DEV=0

# uvicorn: yalnızca aynı makinedeki nginx'in X-Forwarded-For başlığına güven.
FORWARDED_ALLOW_IPS=127.0.0.1
